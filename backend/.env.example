# Server
PORT=8080
PUBLIC_BASE_URL=http://localhost:8080

# Comma-separated origins for CORS
ALLOWED_ORIGINS=http://127.0.0.1:5500,http://localhost:5500

# After KOMOJU payment, user returns to questioner flow
FRONTEND_RETURN_URL=http://127.0.0.1:5500/question-box/pages/questioner.html

# Supabase (Dashboard → Project Settings → API)
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# KOMOJU Test mode → Merchant Settings → Secret Key
KOMOJU_SECRET_KEY=sk_test_xxxxxxxx

# KOMOJU Dashboard → Webhooks (optional for test; required for konbini etc.)
KOMOJU_WEBHOOK_SECRET=

# Cloudinary unsigned upload
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_UPLOAD_PRESET=your-unsigned-preset
